{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/^compose/.*\\.ya?ml$/"
    ],
    "digest": {
      "enabled": false
    }
  },
  "enabledManagers": [
    "docker-compose"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "ghcr.io/blakeblackshear/frigate:0.16.0"
      ],
      "enabled": false
    }
  ],
  "ignoreTests": true
}
